---
---

<footer>
  <div class="footer-inner">
    <div class="reveal">
      <div class="footer-brand-name">晴天 🌿</div>
      <p class="footer-tagline">
        用影片記錄生活裡那些平凡又珍貴的瞬間。<br>
        謝謝你的陪伴！
      </p>
      <div class="footer-socials">
        <a href="#" class="social-pill">抖音</a>
        <a href="#" class="social-pill">Instagram</a>
        <a href="#" class="social-pill">Twitch</a>
        <a href="#" class="social-pill">Twitter / X</a>
      </div>
    </div>
    <div class="reveal reveal-delay-1">
      <div class="footer-col-title">快速連結</div>
      <ul class="footer-links">
        <li><a href="#">最新影片</a></li>
        <li><a href="#">直播回放</a></li>
        <li><a href="#">關於晴天</a></li>
        <li><a href="#">相簿</a></li>
      </ul>
    </div>
    <div class="reveal reveal-delay-2">
      <div class="footer-col-title">合作邀約</div>
      <ul class="footer-links">
        <li><a href="#">業配合作</a></li>
        <li><a href="#">媒體採訪</a></li>
        <li><a href="#">聯絡信箱</a></li>
      </ul>
    </div>
  </div>
  <div class="footer-bottom">
    <span>&copy; 2026 晴天. All Rights Reserved.</span>
    <span>Made with 🌿 in Taiwan</span>
  </div>
</footer>

<style>
  footer { background: var(--bg2); padding: 80px 48px 48px; }
  .footer-inner {
    display: grid; grid-template-columns: 1.5fr 1fr 1fr;
    gap: 60px; padding-bottom: 60px;
    border-bottom: 1px solid var(--warm); margin-bottom: 40px;
  }
  .footer-brand-name { font-family: 'DM Serif Display', serif; font-size: 32px; color: var(--ink); margin-bottom: 12px; }
  .footer-tagline { font-size: 14px; line-height: 1.7; color: var(--mid); margin-bottom: 28px; max-width: 280px; }
  .footer-socials { display: flex; gap: 10px; flex-wrap: wrap; }
  .social-pill {
    font-family: 'Syne', sans-serif; font-size: 12px; font-weight: 600;
    padding: 8px 18px; border-radius: 100px;
    border: 1.5px solid var(--warm); color: var(--mid);
    text-decoration: none; transition: all 0.25s;
  }
  .social-pill:hover { border-color: var(--sage); color: var(--sage); background: rgba(122,158,126,0.06); }
  .footer-col-title {
    font-family: 'Syne', sans-serif; font-size: 12px; font-weight: 700;
    letter-spacing: 0.12em; text-transform: uppercase;
    color: var(--mid); margin-bottom: 20px;
  }
  .footer-links { list-style: none; display: flex; flex-direction: column; gap: 12px; }
  .footer-links a { font-size: 14px; color: var(--ink); text-decoration: none; transition: color 0.25s; }
  .footer-links a:hover { color: var(--sage); }
  .footer-bottom {
    display: flex; justify-content: space-between; align-items: center;
    font-size: 12px; color: var(--mid); letter-spacing: 0.05em;
  }

  @media (max-width: 768px) {
    footer { padding: 60px 20px 40px; }
    .footer-inner { grid-template-columns: 1fr; gap: 40px; }
    .footer-bottom { flex-direction: column; gap: 8px; text-align: center; }
  }
</style>
